{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuSSH",
  "version": "1.2.4",
  "identifier": "com.russh.desktop",
  "build": {
    "beforeDevCommand": "npm run tauri:dev:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run tauri:build:frontend",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RuSSH",
        "width": 1600,
        "height": 980,
        "minWidth": 1280,
        "minHeight": 760,
        "visible": false,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc://localhost http://127.0.0.1:5173 ws://127.0.0.1:5173; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["../themes/builtin/**/*"],
    "targets": "all",
    "icon": ["../build/icon.icns", "../build/icon.ico", "../build/icon.png"]
  }
}
